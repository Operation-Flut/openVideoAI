<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
    Id="*"
    Name="openVideoAI"
    Language="1033"
    Version="__WINDOWS_VERSION__"
    Manufacturer="openVideoAI"
    UpgradeCode="{F32A90F9-E651-4D75-A1B6-717F7F5DAD7E}">

    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perUser"
      Comments="openVideoAI - Local AI Video Enhancement" />

    <MajorUpgrade
      DowngradeErrorMessage="A newer version of openVideoAI is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- == Directory layout ====================================== -->
    <Directory Id="TARGETDIR" Name="SourceDir">

      <!-- Install to %LocalAppData%\Programs\openVideoAI (perUser) -->
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="openVideoAI" />
        </Directory>
      </Directory>

      <!-- Start Menu shortcut lives under the user's Programs folder -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="openVideoAI" />
      </Directory>

      <!-- Desktop shortcut -->
      <Directory Id="DesktopFolder" Name="Desktop" />

    </Directory>

    <!-- == Shortcuts =============================================== -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut"
                 Guid="{6D5A1F3B-9C2E-4D8A-B7F1-E4C3A2B1D0F9}">
        <Shortcut Id="StartMenuShortcutLink"
                  Name="openVideoAI"
                  Description="Local AI Video Enhancement"
                  Target="[INSTALLFOLDER]openVideoAI.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanupStartMenu"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <!-- Also clean up the install folder on uninstall -->
        <RemoveFolder Id="RemoveInstallFolder"
                      Directory="INSTALLFOLDER"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\openVideoAI"
                       Name="StartMenuInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop shortcut -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut"
                 Guid="{7E4B2F1A-8D5C-4A9B-B3E6-C2D1F8A09357}">
        <Shortcut Id="DesktopShortcutLink"
                  Name="openVideoAI"
                  Description="Local AI Video Enhancement"
                  Target="[INSTALLFOLDER]openVideoAI.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\openVideoAI"
                       Name="DesktopInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Application icon (used by shortcuts) -->
    <Icon Id="AppIcon" SourceFile="assets\icon\black_glass.ico" />

    <!-- == Features ============================================= -->
    <Feature Id="MainFeature" Title="openVideoAI" Level="1">
      <!--
        All application files (openVideoAI.exe, _internal\*, UI, assets,
        models.json, etc.) are harvested at build time by heat.exe into the
        AppFiles component group. See .github/workflows/release.yml.
      -->
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

  </Product>
</Wix>
